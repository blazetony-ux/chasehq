# included regression/regression-sprite-ownership.chqscript
# name: Regression - Sprite Ownership and Export Coordinates
# category: regression
# purpose: Assert front body ownership, uncovered black shadow, overlap coverage and per-sprite/live coordinate agreement at canonical frame 2352.
# target: stage1-driving-2352.chqstate; body slot 82/map 475 and shadow slot 81/map 575.
# method: Capture aggregate plus body/shadow solo snapshots under descending traversal and assert overlap ownership/export coordinates.
# expected: Nonzero overlap is never owned by slot 81, body-owned overlap is nonzero, shadow remains visible outside body, and exportCoordinatesExact=true.
# cleanup: Restore lower-slot traversal and clear sprite visual/override state even if capture/assertion fails.
# regression-version: 0.66.9.0
# regression-scope: version

api sprite.visual.clear
api sprite.override.clear
api sprite.order.set mode=lower-slot

try
    api checkpoint.load file=stage1-driving-2352.chqstate run=false
    assert status frame=2352
    api sprite.order.inspect
    api frame.snapshot name=regression-sprite-ownership
    api sprite.visual slot=82 mode=solo
    api frame.snapshot name=regression-sprite-body-solo
    api sprite.visual slot=81 mode=solo
    api frame.snapshot name=regression-sprite-shadow-solo
    api sprite.visual.clear
    api frame.snapshot.assert-overlap name=regression-sprite-ownership front=82 back=81 frontSolo=regression-sprite-body-solo backSolo=regression-sprite-shadow-solo
finally
    api sprite.visual.clear
    api sprite.override.clear
    api sprite.order.set mode=lower-slot
end

echo === Sprite ownership and export coordinate assertions COMPLETE ===


# v0.66.9.0 RC2.5 safe experiment lifecycle / timeline cleanup
# included regression/regression-v06690-rc25-script-safety.chqscript
# name: Regression - v0.66.9.0 RC2.5 Script Safety
# purpose: Prove timeline.reset restores the pre-load live checkpoint after a timeline seek/fork and exercise the try/finally cleanup path.
# category: regression
# target: self-contained two-frame timeline recorded from stage1-driving-2352 plus canonical stage1-gameplay-2064 live state.
# method: Create the timeline fixture in this run, establish frame 2064, load/seek/fork frame 2352 inside try, then restore with timeline.reset in finally.
# expected: The fork reaches frame 2352 and cleanup returns the live emulator to frame 2064 before the terminal COMPLETE marker.
# cleanup: timeline.reset is called before and in finally; sprite visual/override state is cleared defensively.
# regression-version: 0.66.9.0-RC2.5
# regression-scope: permanent

api timeline.reset
api sprite.visual.clear
api sprite.override.clear

# Permanent regressions must create their own timeline fixture rather than
# depending on a prior research run or another regression's artifacts.
api checkpoint.load file=stage1-driving-2352.chqstate run=false
assert status frame=2352
api timeline.record.start name=regression-v06690-rc25-script-safety
api control.run-frames frames=1
api timeline.record.stop

# Establish the live state that timeline.reset must restore after load/seek/fork.
api checkpoint.load file=stage1-gameplay-2064.chqstate run=false
assert status frame=2064

try
    api timeline.load name=regression-v06690-rc25-script-safety
    api timeline.seek frame=2352
    api timeline.fork-live
    assert status frame=2352
finally
    api sprite.visual.clear
    api sprite.override.clear
    api timeline.reset
end

assert status frame=2064
echo === v0.66.9.0 RC2.5 Script Safety: COMPLETE ===



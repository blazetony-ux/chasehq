# Current platform/release contracts consolidated from historical RC3.2-RC3.4.x/v0.66.9.1/v0.66.9.2 release-tail scripts.
# See docs/REGRESSION_COVERAGE_MAP.md for explicit coverage equivalence.
# included regression/regression-platform-current-contracts.chqscript
# name: Current Platform Contracts Regression
# category: regression
# regression-version: current
# regression-scope: permanent
# purpose: Consolidated current-build proof for release identity, script/checkpoint schema, legacytrace lifecycle, checkpoint evidence closure, track/checkpoint semantics, authoritative run history, and deterministic final player-gameplay restoration. Supersedes repeated execution of historical RC3.2-RC3.4.x/v0.66.9.1/v0.66.9.2 release-tail scripts without reducing their unique contract coverage.
# checkpoint: stage1-gameplay-2064.chqstate

echo === ChaseHQ Current Platform Contracts: BEGIN ===
api release.assert-version
api schema action=script.run
api schema action=checkpoint.save
api status

# One canonical legacytrace/checkpoint lifecycle replaces the same flow repeated by historical RC3.2-RC3.4.4 release scripts.
api checkpoint.load file=stage1-driving-2352.chqstate run=false
api gameplay.registry
api track.state
legacytrace reset
legacytrace cpu A
legacytrace mem 10A04A:10A04B r
legacytrace context 0 0
legacytrace max 256
legacytrace output evidence\regression-current-platform-trace.log
legacytrace start
api control.run-frames frames=4
legacytrace stop
api checkpoint.save file=regression-current-platform-checkpoint.chqstate
api checkpoint.list
api script.runs limit=5

# Preserve the v0.66.9.2 checkpoint-context / track-schema contract and restore genuine player gameplay.
api checkpoint.load file=stage1-gameplay-2064.chqstate run=false
api gameplay.registry
api track.state
api track.records before=1 after=1
api script.runs limit=5
api checkpoint.load file=stage1-gameplay-2064.chqstate run=false
api status
echo === ChaseHQ Current Platform Contracts: COMPLETE ===


# v0.66.9.3-RC3 research-tooling hardening
# included regression/regression-v06693-rc3.chqscript
# name: v0.66.9.3-RC3 Research Tooling Hardening Regression
# category: regression
# regression-version: 0.66.9.3-RC3
# regression-scope: release
# purpose: Final tooling-hardening probe before a diagnosis-heavy work period: authoritative source-line provenance, client-side wait evidence parity, resolved-source capture, portable/navigable evidence bundles, structured corpus results, runtime queries, tuple iteration and deterministic gameplay restoration. No intentional emulation/game behavior changes.
# checkpoint: stage1-gameplay-2064.chqstate

echo === ChaseHQ v0.66.9.3-RC3 Tooling Regression: BEGIN ===
api release.assert-version
api schema action=sprite.shadow.compare
api schema action=query.runtime
api schema action=corpus.run
api schema action=script.run.verify
api script.schema

# Client-only wait must still appear in authoritative console/resolved-command evidence.
wait 25

api checkpoint.load file=stage1-gameplay-2064.chqstate run=false
api sprite.shadow.compare scope=visible failOnMismatch=false

# Nested expansion must preserve the authored line of the API command below.
repeat 1
  for address,width in [(1002AE,16),(1002D8,16)]
    api memory.read cpu=A address=${address} width=${width}
  end
end

# try/finally source provenance must also remain absolute.
try
  api query.runtime function=getmaps()
  api query.runtime function=getregistry()
finally
  api status
end

# Corpus rows must remain typed JSON objects and caller state must be restored.
api corpus.run checkpoints=stage1-driving-2352.chqstate,stage1-gameplay-2064.chqstate action=sprite.shadow.compare scope=visible failOnMismatch=false
api query.runtime function=gettrackrecords(before=1,after=1)
api script.runs limit=5

api checkpoint.load file=stage1-gameplay-2064.chqstate run=false
api status
echo === ChaseHQ v0.66.9.3-RC3 Tooling Regression: COMPLETE ===



# checkpoint: stage1-target-immediate-pre-damage-6333.chqstate
# purpose: Prove native one-hit target toggle on a known authentic damage frame and exercise RC2.9 API contracts.

echo === RC2.9 target health/tooling regression ===
api release.assert-version
api schema action=game.target.one-hit
api schema action=control.run-frames

try
  api game.target.one-hit enabled=false
  api checkpoint.load file=stage1-target-immediate-pre-damage-6333.chqstate run=false

  if memory cpu=A address=1002AE width=16 value = 000E
    echo PASS canonical 6333 target counter = 000E
  else
    echo FAIL canonical 6333 target counter mismatch
  end

  api game.target.one-hit enabled=true
  api control.run-frames frames=2 timeout=900000

  if memory cpu=A address=1002AE width=16 value = FFFF
    echo PASS one-hit preserved authentic terminal underflow
  else
    echo FAIL one-hit terminal underflow
  end

  api control.run-frames frames=14 timeout=900000
  if memory cpu=A address=10018D width=8 value = 05
    echo PASS one-hit entered authentic defeat mode
  else
    echo FAIL one-hit defeat mode
  end

  api game.experiment.status
finally
  api game.target.one-hit enabled=false
  api patch.clear
  api input.ioc.clear
  api collision.response.reset
  api checkpoint.load file=stage1-driving-2352.chqstate run=false
end

assert status frame=2352
echo === RC2.9 target health/tooling regression complete ===



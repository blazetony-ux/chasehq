# category: gameplay
# name: Stage 1 Baseline 3 Seconds
# purpose: Establish normal Stage 1 progression without IOC intervention.
# checkpoint: stage1-gameplay-2064.chqstate

api checkpoint.load file=stage1-gameplay-2064.chqstate run=false
api input.ioc.clear

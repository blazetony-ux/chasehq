# name: Stage 1 Course Mapping - 3600 frame evidence survey
# category: track
# regression-version: 0.66.9.0-RC3.0
# purpose: Controlled Stage 1 mapping run with native closed-loop road following, 15-frame structured samples, 60-frame screenshot/state landmarks, topology-write provenance and reconstructable mapping export.

api release.assert-version
api checkpoint.load file=stage1-gameplay-2064.chqstate run=false
api course.follow.configure controller=hybrid lookahead=8 bias=0 speedControl=true
api experiment.begin name=stage1-course-mapping-3600

try
  api course.survey.start collisionResponse=false timerHold=true
  api memory.trace.clear
  api memory.trace.start cpu=A address=10A058 length=2 width=any limit=512
  api track.record.sample
  api experiment.capture label=landmark-start include=sprites,gameplay,track

  repeat 60
    repeat 4
      api control.run-frames frames=15 timeout=900000
      api track.record.sample
    end
    api experiment.capture label=landmark-${repeat_index} include=sprites,gameplay,track
  end

  api memory.trace.stop
  api memory.trace.tail count=512
  api track.record.status
  api course.follow.status
  api track.map.export name=stage1-course-mapping-3600
  api experiment.capture label=landmark-end include=sprites,gameplay,track
finally
  api memory.trace.stop
  api course.survey.stop
  api experiment.end
  api patch.clear
  api input.ioc.clear
  api collision.response.reset
  api timer.hold enabled=false
end

echo === RC3.0 STAGE 1 COURSE MAPPING 3600 COMPLETE ===

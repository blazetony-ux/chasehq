# name: Stage 1 Track Survey - 1800
# category: track
# purpose: Survey Stage 1 track state across 1800 frames.
# Stage 1 autonomous attract-mode track survey - 1800 frames
# Samples every 30 frames and captures every 300 frames.
api patch.clear
api checkpoint.load file=stage1-driving-2352.chqstate run=false
echo === STAGE 1 TRACK SURVEY 1800 BEGIN ===
api frame.snapshot name=track-survey-1800-start
repeat 6
    repeat 10
        api control.run-frames frames=30
        api track.state
    end
    api frame.snapshot
    api gameplay.registry
end
api status
api track.state
api frame.snapshot name=track-survey-1800-end
echo === STAGE 1 TRACK SURVEY 1800 COMPLETE ===

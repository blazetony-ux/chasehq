# name: Current-state material/object survey - 1200 frames
# category: track
# regression-version: 0.66.9.0-RC3.1
# purpose: Survey the currently paused genuine gameplay state for stable surface candidates, raw TC0150 renderer evidence, player trajectory and heuristic object-candidate tracks without forcing a Stage 1 checkpoint.

api release.assert-version
api course.follow.configure controller=hybrid lookahead=8 bias=0 speedControl=true
api experiment.begin name=current-state-material-object-survey-1200

try
  api course.survey.start collisionResponse=false timerHold=true
  api memory.trace.clear
  api memory.trace.start cpu=A address=10A058 length=2 width=any limit=384
  api track.record.sample
  api experiment.capture label=start include=sprites,gameplay,track

  repeat 20
    repeat 4
      api control.run-frames frames=15 timeout=900000
      api track.record.sample
    end
    api experiment.capture label=landmark-${repeat_index} include=sprites,gameplay,track
  end

  api memory.trace.stop
  api memory.trace.tail count=384
  api track.record.status
  api course.follow.status
  api track.map.export name=current-state-material-object-survey-1200
  api experiment.capture label=end include=sprites,gameplay,track
finally
  api memory.trace.stop
  api course.survey.stop
  api experiment.end
  api patch.clear
  api input.ioc.clear
  api collision.response.reset
  api timer.hold enabled=false
end

echo === RC3.1 CURRENT-STATE MATERIAL/OBJECT SURVEY 1200 COMPLETE ===

# name: Current State Course Mapping - parameterized
# category: track
# regression-version: 0.66.9.0-RC3.2
# purpose: Parameterized autonomous survey from the currently loaded paused gameplay state. Intended for mobile/Workbench/API launch without creating a separate script for every frame count.
# param frames type=select values=300,600,900,1200,2400,3600 default=1200

api release.assert-version
api course.follow.configure controller=hybrid lookahead=8 bias=0 speedControl=true
api experiment.begin name=current-state-course-mapping-${frames}
api course.survey.start collisionResponse=false timerHold=true
api track.record.sample
api experiment.capture label=start include=sprites,gameplay,track
api control.run-frames frames=${frames} timeout=3600000
api track.record.sample
api experiment.capture label=end include=sprites,gameplay,track
api track.record.status
api course.follow.status
api track.map.export name=current-state-course-mapping-${frames}
api course.survey.stop
api experiment.end
echo === RC3.2 PARAMETERIZED CURRENT-STATE SURVEY ${frames} COMPLETE ===

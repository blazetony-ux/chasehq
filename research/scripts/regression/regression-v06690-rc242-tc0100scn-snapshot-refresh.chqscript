# name: Regression - v0.66.9.0 RC2.4.2 TC0100SCN / Snapshot Refresh
# category: regression
# purpose: Exercise the corrected TC0100SCN render path and prove a newly created structured snapshot is immediately discoverable by frame.snapshot.list in the same script run.
# checkpoint: stage1-gameplay-2064.chqstate
# regression-version: 0.66.9.0
# regression-scope: current

echo === RC2.4.2 TC0100SCN / snapshot refresh regression ===
api checkpoint.load file=stage1-gameplay-2064.chqstate run=false
api control.step-frame
api frame.snapshot name=regression-rc242-tc0100scn sprites=individual
api frame.snapshot.list
api image.compare a=regression-rc242-tc0100scn b=regression-rc242-tc0100scn region=FULL hud=normal
api image.compare a=regression-rc242-tc0100scn b=regression-rc242-tc0100scn region=FULL hud=hidden
echo === RC2.4.2 regression complete ===

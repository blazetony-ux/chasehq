include "regression/regression-v06661-layered-frame-snapshot.chqscript"

# v0.66.7.5 User Handbook / live-reference regression
include "regression/regression-v06675-user-handbook.chqscript"

# v0.66.7.6 documentation/search/export consolidation
include "regression/regression-v06676-docs-consolidation.chqscript"

# v0.66.7.7 authoritative run-history + completed-run snapshot discovery
include "regression/regression-v06677-run-history-snapshot-discovery.chqscript"

include "regression/regression-v06678-discovery-performance.chqscript"
echo --- v0.66.7.8 run finalization ---
include "regression/regression-v06678-run-finalization.chqscript"

# v0.66.7.9 research recovery / corrected turbo knowledge
include "regression/regression-v06679-research-recovery.chqscript"

# v0.66.8.0 Forensic Timeline v1
include "regression/regression-v06680-forensic-timeline.chqscript"

# v0.66.8.0 RC7 portable automated timeline analysis
include "regression/regression-v06680-rc7-portable-auto-analysis.chqscript"

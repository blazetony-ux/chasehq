# name: Regression - v0.66.9.0 RC2.6.1 Sprite Bitplane Significance
# category: regression
# purpose: Exercise the RC2.6 shared sprite decoder at canonical Map 405 and require a current-run structured snapshot with no palette overrides.
# checkpoint: stage1-driving-2352.chqstate
# target: Stage 1 frame 2352 / Map 405 / palette bank 175.
# method: Clear palette overrides, load the canonical frame, inspect Map 405, capture an individual-sprite snapshot, require immediate discovery, and self-compare the final frame.
# expected: Frame 2352 is retained, the named snapshot is discoverable in the current run, and the self-comparison is exact. The exhaustive 16-pen decoder invariant is asserted separately by Test-SpriteGfx.bat.
# cleanup: Palette overrides are cleared in finally; canonical frame 2352 remains loaded.
# regression-version: 0.66.9.0-RC2.6.1
# regression-scope: current

echo === v0.66.9.0 RC2.6.1 Sprite Bitplane Significance regression ===

api palette.overrides.clear
api checkpoint.load file=stage1-driving-2352.chqstate run=false
assert status frame=2352

try
    api sprite.map.inspect map=405
    api frame.snapshot name=regression-rc261-map405-bitplane sprites=individual
    api frame.snapshot.list require=regression-rc261-map405-bitplane
    api image.compare a=regression-rc261-map405-bitplane b=regression-rc261-map405-bitplane region=FULL hud=normal
finally
    api palette.overrides.clear
end

assert status frame=2352
echo === v0.66.9.0 RC2.6.1 Sprite Bitplane Significance regression COMPLETE ===

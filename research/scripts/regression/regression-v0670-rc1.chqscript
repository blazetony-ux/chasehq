# regression-version: 0.67.0.0-RC1
# name: v0.67.0-RC1 Native Implementation Milestone
# category: regression
# purpose: Prove native sprites are the default-capable path and harvest initial independent TC0100SCN text/HUD Shadow parity across canonical states.

echo === v0.67.0-RC1 native implementation regression ===
api release.assert-version

try
  api sprite.override.clear
  api sprite.visual.clear
  api sprite.map-override.clear
  api sprite.asset-replace.clear
  api patch.clear
  api hud.layout.reset
  api layer.offsets.reset layer=all

  echo === NATIVE SPRITE DEFAULT / PROMOTED PATH ===
  api backend.sprite.set mode=native
  api backend.sprite.get
  api checkpoint.load file=stage1-gameplay-2064.chqstate run=false
  api control.run-frames frames=8
  api checkpoint.load file=stage2-gameplay-7500.chqstate run=false
  api control.run-frames frames=8
  api backend.sprite.get

  echo === TC0100SCN TEXT SHADOW BRING-UP ===
  api backend.text.reset-verification
  api backend.text.set mode=shadow

  api checkpoint.load file=stage1-gameplay-2064.chqstate run=false
  api control.run-frames frames=8
  api backend.text.get

  api checkpoint.load file=stage1-driving-2352.chqstate run=false
  api control.run-frames frames=8
  api backend.text.get

  api checkpoint.load file=stage2-gameplay-7500.chqstate run=false
  api control.run-frames frames=8
  api backend.text.get

  echo === ZERO OUTPUT REFERENCE ===
  api checkpoint.load file=stage1-end-level-9988.chqstate run=false
  api control.run-frames frames=2
  api backend.text.get

  echo === v0.67.0-RC1 regression body complete ===
finally
  api sprite.override.clear
  api sprite.visual.clear
  api sprite.map-override.clear
  api sprite.asset-replace.clear
  api patch.clear
  api hud.layout.reset
  api layer.offsets.reset layer=all
  api backend.sprite.set mode=native
  api backend.text.set mode=shadow
  api checkpoint.load file=stage1-gameplay-2064.chqstate run=false
  api status
end

echo === v0.67.0-RC1 native implementation regression complete ===

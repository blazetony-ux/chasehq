{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "x64-debug",
      "displayName": "Windows x64 Debug",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/x64-Debug",
      "cacheVariables": { "CHASEHQ_BUILD_SDL": "ON" }
    },
    {
      "name": "x64-release",
      "displayName": "Windows x64 Release",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/x64-Release",
      "cacheVariables": { "CHASEHQ_BUILD_SDL": "ON" }
    },
    {
      "name": "cpu-debug",
      "displayName": "CPU-only Debug",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/cpu-Debug",
      "cacheVariables": { "CHASEHQ_BUILD_SDL": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "x64-debug", "configurePreset": "x64-debug", "configuration": "Debug" },
    { "name": "x64-release", "configurePreset": "x64-release", "configuration": "Release" },
    { "name": "cpu-debug", "configurePreset": "cpu-debug", "configuration": "Debug" }
  ],
  "testPresets": [
    { "name": "x64-debug", "configurePreset": "x64-debug", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "x64-release", "configurePreset": "x64-release", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "cpu-debug", "configurePreset": "cpu-debug", "configuration": "Debug", "output": { "outputOnFailure": true } }
  ]
}
